# Copy this file to .env and adjust the values. Never commit .env.
#   cp .env.example .env
#
# The API alone (`make run-api`) starts without a .env file. Docker Compose
# (`make up`) needs one, because the database and admin passwords have no
# defaults on purpose.

# --- Application ---------------------------------------------------
# local | test | production. Production hides the interactive API docs.
APP_ENV=local

# --- Logging -------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json: one JSON object per line (Docker, CI). console: readable lines for local work.
# Docker Compose always uses json for the API container.
LOG_FORMAT=console

# --- API -----------------------------------------------------------
# Used when the API runs outside Docker. In Docker it listens on 0.0.0.0:8000
# inside the container, and API_PORT is the port published on your machine.
API_HOST=127.0.0.1
API_PORT=8000

# Connection strings for the API when it runs outside Docker. Leave them
# empty to skip those checks in /readyz. Docker Compose builds its own from
# the values further down, so these are not used there.
# Example: postgresql://app:<password>@localhost:5432/knowledge
POSTGRES_URL=
# Example: redis://:<password>@localhost:6379/0
REDIS_URL=

# Seconds each /readyz check may take before it counts as failed.
READINESS_TIMEOUT_SECONDS=2
# Request metrics for Prometheus on /metrics.
METRICS_ENABLED=true

# --- Pinecone (document search) -----------------------------------
# Free key from https://app.pinecone.io. Needed by `make ingest`.
# Leave it empty to run everything else; `make ingest-check` works without it.
PINECONE_API_KEY=
# Created by `make ingest` if it does not exist (dotproduct, 1024 dimensions).
PINECONE_INDEX_NAME=helix-knowledge
# The free Starter plan only offers aws / us-east-1.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Pinecone-hosted embedding model and its size. Change both together, then
# delete the index and run `make ingest` again.
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIMENSION=1024

# --- Hybrid search -------------------------------------------------
# score = alpha x meaning (dense) score + (1 - alpha) x keyword (BM25) score.
# 1.0 is meaning only; it must stay above 0. Tune it with `make eval-retrieval`.
HYBRID_ALPHA=0.5
# Chunks returned per search, and matches asked from each collection first.
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES_PER_COLLECTION=20
# At most this many chunks from one document in a result.
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
# Time limit for each Pinecone call during a search.
RETRIEVAL_TIMEOUT_SECONDS=8
# Pinecone-hosted re-ranker. If it fails or the free quota runs out, the
# search keeps the hybrid order.
RERANK_ENABLED=true
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=30

# --- Language models -----------------------------------------------
# Claude answers first. If it fails, times out or is rate limited, Gemini
# takes over. One key is enough to run the agents; set both for real
# failover between two companies. Every provider with a key needs its
# model here too: model names have no default in the code, because models
# are renamed and retired often. The values below are the recommended ones.
#
# Key from https://console.anthropic.com/settings/keys (paid per token).
# claude-haiku-5-5 is the cheapest current Claude model. In testing, a
# document question cost about US$0.001 and deep research about US$0.004.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# The longest reply Claude may write, in tokens. Answers need well under
# 2,000; the cap stops a runaway reply from costing more.
ANTHROPIC_MAX_TOKENS=2000
# How much work Claude puts into each reply: low, medium or high. "low" is
# the cheapest and is enough for these tasks.
ANTHROPIC_EFFORT=low
# Free key from https://aistudio.google.com/apikey (the backup model)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# The order the models are tried in. The first answers; the next takes over
# when it fails. Swap to gemini,anthropic to put Gemini first, or list one
# name to use only that model. Restart the API after a change.
LLM_PROVIDERS=anthropic,gemini
# Gemini only. Low temperature keeps routing and answers close to the
# sources. Claude always runs at its own default.
LLM_TEMPERATURE=0.2
# Seconds per model call, and retries inside one provider before the next
# provider is tried.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Circuit breaker per provider: after this many failures within the window,
# or one "rate limited" reply, the provider is skipped for LLM_BREAKER_OPEN_SECONDS
# and then tried again with one probe call.
LLM_BREAKER_FAILURES=5
LLM_BREAKER_WINDOW_SECONDS=60
LLM_BREAKER_OPEN_SECONDS=30

# --- Agents --------------------------------------------------------
# Earlier messages of the conversation the agents see (for follow-ups).
AGENT_HISTORY_MESSAGES=6

# --- Research agent ----------------------------------------------
# Recursive research for analysts and admins: at most this many batches,
# this deep, this many model tokens per question, and this many sources
# handed to the answer.
RESEARCH_MAX_DEPTH=3
RESEARCH_MAX_FANOUT=5
RESEARCH_TOKEN_BUDGET=40000
RESEARCH_MAX_SOURCES=20
# Free model tiers allow only a few requests a minute: batch sub-agents make
# at most this many model calls at once, and only this many batches get
# model-written findings (the rest still give their sources to the answer).
RESEARCH_PARALLEL_CALLS=2
RESEARCH_MAX_EXTRACTIONS=4

# --- Memory -------------------------------------------------------
# Conversations and long-term memory are kept in Postgres when POSTGRES_URL
# is set (always in Docker Compose), in memory otherwise.
MEMORY_ENABLED=true
# What the admin clean-up (POST /admin/memory/cleanup) deletes.
MEMORY_RETENTION_DAYS=30
# A thread longer than this gets a running summary in prompts.
MEMORY_SUMMARY_AFTER_MESSAGES=12

# --- Human approval ----------------------------------------------
# Ask the user before deep research runs (it can cost several model calls).
# They answer in the UI, or with POST /approvals/{thread_id}.
APPROVAL_FOR_RESEARCH=true

# --- Chat stream (POST /chat) --------------------------------------
# Time limit for one whole answer, and how often a keep-alive line is
# sent while the agents are working.
CHAT_TIMEOUT_SECONDS=120
CHAT_KEEPALIVE_SECONDS=15

# --- Login (Keycloak) ----------------------------------------------
# Every API request except the health checks needs a Keycloak access token.
# These values match infra/keycloak/realm-helix.json. Docker Compose sets
# its own (the API reaches Keycloak at http://keycloak:8080 there), so
# they only matter when the API runs outside Docker (`make run-api`).
# Where the API fetches Keycloak's public signing keys from.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=helix
# The issuer and audience every token must carry.
AUTH_ISSUER=http://localhost:8080/realms/helix
AUTH_AUDIENCE=enterprise-knowledge-api
# Seconds the signing keys are kept before they are fetched again, and the
# shortest wait between two early fetches (for a key the API has not seen).
AUTH_JWKS_CACHE_SECONDS=300
AUTH_JWKS_MIN_REFRESH_SECONDS=30
# Seconds a token is still accepted after it expires (clock differences).
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_TIMEOUT_SECONDS=3

# --- Rate limiting -------------------------------------------------
# Questions per minute (token buckets per user, sized by role, plus one
# bucket shared by all users of a role) and a daily budget of language
# model tokens per user. Admins can change the per-role values while the
# API runs (PUT /admin/rate-limits/{role}); these are the starting values.
RATE_LIMIT_ENABLED=true
# Questions a user may send back to back before the per-minute rate applies.
RATE_LIMIT_BURST=5
RATE_LIMIT_VIEWER_PER_MINUTE=10
RATE_LIMIT_ANALYST_PER_MINUTE=20
RATE_LIMIT_ADMIN_PER_MINUTE=40
# All users of one role together.
RATE_LIMIT_ROLE_PER_MINUTE=120
# Language model tokens per user per day (reset at 00:00 UTC).
RATE_LIMIT_VIEWER_DAILY_TOKENS=100000
RATE_LIMIT_ANALYST_DAILY_TOKENS=250000
RATE_LIMIT_ADMIN_DAILY_TOKENS=500000
# Reserved before each question and corrected when the answer ends.
RATE_LIMIT_TOKENS_PER_QUESTION=4000
# If Redis is down, each API worker counts on its own with limits x this.
RATE_LIMIT_FALLBACK_FACTOR=0.5
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.5

# --- Python sandbox -----------------------------------------------
# Where the API sends Python to run (the analysts' Python tool and the
# research agent's search plans). Docker Compose sets http://sandbox:8100.
# Leave empty when running the API on its own: the tool then answers 503.
SANDBOX_URL=
SANDBOX_TIMEOUT_SECONDS=10

# --- Enterprise data tools (MCP server) ---------------------------
# Where the tools agent reaches the MCP server. Docker Compose sets
# http://mcp:8200/mcp. Leave empty to answer enterprise-data questions from
# the documents only.
MCP_URL=
MCP_TIMEOUT_SECONDS=10

# --- Chat UI (Streamlit) -------------------------------------------
# Port of the UI on your machine with Docker Compose (http://localhost:8501).
UI_PORT=8501
# The UI finds the API through API_URL and Keycloak through KEYCLOAK_URL.
# `make run-ui` uses the localhost addresses and Docker Compose the service
# names, so neither is set here for the UI. Its other settings are listed
# in ui/README.md.

# --- LangSmith tracing ---------------------------------------------
# Off unless set to true and a key is given. Free key from
# https://smith.langchain.com (Settings > API Keys). Use it with the
# fictional sample data only: questions are sent as typed.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=helix-knowledge-agent
# EU accounts: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Docker Compose: passwords -------------------------------------
# Replace every "change-me" value. Use letters, digits, "-" and "_" only,
# because the passwords are placed inside connection URLs.

# Postgres: the application database and its owner.
POSTGRES_DB=knowledge
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-postgres

# Keycloak keeps its data in its own Postgres database, with its own user.
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Redis (rate-limit counters and admin changes to the limits).
REDIS_PASSWORD=change-me-redis

# Keycloak admin console at http://localhost:8080/admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Grafana at http://localhost:3000 (only with `make up-observability`). User: admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
