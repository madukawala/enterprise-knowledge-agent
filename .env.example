# Copy this file to .env and adjust the values. Never commit .env.
# Every variable has a safe default, so the API starts without a .env file.
# Later features add their settings here (API keys, Keycloak, databases).

# --- Application ---------------------------------------------------
# local | test | production. Production hides the interactive API docs.
APP_ENV=local

# --- Logging -------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json: one JSON object per line (Docker, CI). console: readable lines for local work.
LOG_FORMAT=console

# --- API -----------------------------------------------------------
# Docker sets this to 0.0.0.0 inside the container. Keep 127.0.0.1 outside Docker.
API_HOST=127.0.0.1
API_PORT=8000
