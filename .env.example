# Copy this file to .env and adjust the values. Never commit .env.
#   cp .env.example .env
#
# The API alone (`make run-api`) starts without a .env file. Docker Compose
# (`make up`) needs one, because the database and admin passwords have no
# defaults on purpose.
# Later features add their settings here (LLM keys, Keycloak client settings).

# --- Application ---------------------------------------------------
# local | test | production. Production hides the interactive API docs.
APP_ENV=local

# --- Logging -------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json: one JSON object per line (Docker, CI). console: readable lines for local work.
# Docker Compose always uses json for the API container.
LOG_FORMAT=console

# --- API -----------------------------------------------------------
# Used when the API runs outside Docker. In Docker it listens on 0.0.0.0:8000
# inside the container, and API_PORT is the port published on your machine.
API_HOST=127.0.0.1
API_PORT=8000

# Connection strings for the API when it runs outside Docker. Leave them
# empty to skip those checks in /readyz. Docker Compose builds its own from
# the values further down, so these are not used there.
# Example: postgresql://app:<password>@localhost:5432/knowledge
POSTGRES_URL=
# Example: redis://:<password>@localhost:6379/0
REDIS_URL=

# Seconds each /readyz check may take before it counts as failed.
READINESS_TIMEOUT_SECONDS=2
# Request metrics for Prometheus on /metrics.
METRICS_ENABLED=true

# --- Pinecone (document search) -----------------------------------
# Free key from https://app.pinecone.io. Needed by `make ingest`.
# Leave it empty to run everything else; `make ingest-check` works without it.
PINECONE_API_KEY=
# Created by `make ingest` if it does not exist (dotproduct, 1024 dimensions).
PINECONE_INDEX_NAME=helix-knowledge
# The free Starter plan only offers aws / us-east-1.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Pinecone-hosted embedding model and its size. Change both together, then
# delete the index and run `make ingest` again.
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIMENSION=1024

# --- Hybrid search -------------------------------------------------
# score = alpha x meaning (dense) score + (1 - alpha) x keyword (BM25) score.
# 1.0 is meaning only; it must stay above 0. Tune it with `make eval-retrieval`.
HYBRID_ALPHA=0.5
# Chunks returned per search, and matches asked from each collection first.
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES_PER_COLLECTION=20
# At most this many chunks from one document in a result.
RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
# Time limit for each Pinecone call during a search.
RETRIEVAL_TIMEOUT_SECONDS=8
# Pinecone-hosted re-ranker. If it fails or the free quota runs out, the
# search keeps the hybrid order.
RERANK_ENABLED=true
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=30

# --- Docker Compose: passwords -------------------------------------
# Replace every "change-me" value. Use letters, digits, "-" and "_" only,
# because the passwords are placed inside connection URLs.

# Postgres: the application database and its owner.
POSTGRES_DB=knowledge
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-postgres

# Keycloak keeps its data in its own Postgres database, with its own user.
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Redis (rate-limit counters).
REDIS_PASSWORD=change-me-redis

# Keycloak admin console at http://localhost:8080/admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Grafana at http://localhost:3000 (only with `make up-observability`). User: admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
